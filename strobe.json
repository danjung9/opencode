{
  "build": { "command": "bun run build", "cwd": "packages/app", "output": "packages/app/dist" },
  "serve": { "command": "bun e2e/utils/serve.ts --host 127.0.0.1 --port {port}", "cwd": "packages/app" },
  "apps": {
    "warcode": {
      "exe": {
        "windows": "%LOCALAPPDATA%/Programs/ai.warcode.desktop/Warcode.exe",
        "macos": "/Applications/Warcode.app/Contents/MacOS/Warcode"
      },
      "unset": ["WARCODE_*", "OTEL_*", "SENTRY_*"],
      "env": {
        "WARCODE_DB": "{home}/.local/share/warcode/warcode.db",
        "WARCODE_CONFIG_DIR": "{home}/.config/warcode",
        "HTTP_PROXY": "http://127.0.0.1:9",
        "HTTPS_PROXY": "http://127.0.0.1:9",
        "NO_PROXY": "localhost,127.0.0.1,::1"
      },
      "dirs": [".local/share/warcode"],
      "files": {
        ".config/warcode/service.json": { "port": "{port}" },
        "AppData/Local/@warcodedesktop-updater": "a file, not a folder: the updater cannot stage a download while strobe measures"
      },
      "guard": [{ "file": "~/.local/state/warcode/service.json", "pid": "pid", "url": "url" }],
      "protocols": ["warcode"]
    },
    "warcode-beta": {
      "extends": "warcode",
      "exe": {
        "windows": "%LOCALAPPDATA%/Programs/ai.warcode.desktop.beta/Warcode Beta.exe",
        "macos": "/Applications/Warcode Beta.app/Contents/MacOS/Warcode Beta"
      }
    }
  }
}
