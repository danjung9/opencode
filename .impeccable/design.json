  "narrative": {
    "northStar": "Workroom",
    "overview": "Warcode is a warm, focused desktop coding environment. Ivory work surfaces, a deeper neutral sidebar, ink typography, and burnt-orange actions give the existing application its approved identity. Density remains appropriate to sessions, projects, code, and model-provider controls.\n\nThis identity fits over the established Electron skeleton. Keep the existing navigation, workspace panels, native controls, session state, keyboard commands, and coding workflows. The approved image establishes material and identity; its illustrative content does not replace the real application structure. PRODUCT.md and .impeccable/workroom-brief.md record this commitment.",
    "keyCharacteristics": [
      "Warm tonal layers with restrained functional orange.",
      "Compact Inter controls, IBM Plex Mono code, and a separately configured terminal font.",
      "Shared vector W monogram and uppercase WARCODE wordmark.",
      "Existing desktop interaction and accessibility behavior."
    ],
    "rules": [
      {
        "name": "The Semantic Roles Rule",
        "body": "Use the relevant semantic token in each namespace; preserve status, code syntax, diff, action, and focus roles independently.",
        "section": "colors"
      },
      {
        "name": "The Foundation Rule",
        "body": "Visual identity changes must preserve the established app skeleton, navigation, commands, sessions, and coding workflows.",
        "section": "components"
      }
    ],
    "dos": [
      "**Do** use the Workroom semantic colors in both existing token namespaces.",
      "**Do** preserve Inter, IBM Plex Mono, configured terminal fonts, and the shared vector Warcode identity.",
      "**Do** retain keyboard focus, disabled/error states, reduced-motion behavior, and the existing desktop navigation structure.",
      "**Do** check new surfaces in light and dark themes and record which device sizes were actually verified."
    ],
    "donts": [
      "**Don't** replace the existing app foundation with the mockup's illustrative layout or sample coding content.",
      "**Don't** reuse orange action emphasis as a substitute for independent status or diff semantics.",
      "**Don't** redraw the wordmark as ordinary text or stretch the shared vector assets.",
      "**Don't** present unverified device classes or a provider-limited model reply as completed visual or functional verification."
    ]
  }
}
